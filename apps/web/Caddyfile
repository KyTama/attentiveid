{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	respond /healthz 200

	# Security headers for every page and file.
	#  - HSTS: browsers only ever use https for this site (no includeSubDomains: other subdomains are run by other teams).
	#  - CSP: scripts and styles only from this site, plus the few outside services the site really uses: the Meta pixel on the
	#    booking page, Google Fonts on the Let There Be Light page, and the services site shown inside /our-services.
	#    'unsafe-inline' stays for scripts/styles because the page has small inline scripts and React sets inline styles;
	#    objects, <base> tags, form posts to other sites and framing of this site are all closed.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://www.facebook.com https://connect.facebook.net; frame-src https://ourservices.attentiveid.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}

	# Link-preview crawlers (WhatsApp, Facebook, X, Telegram...) do not run JavaScript, so they get a
	# small page with the per-page thumbnail set in the portal. Normal visitors and Google are unaffected.
	@linkpreview {
		method GET HEAD
		header_regexp ua User-Agent (?i)(facebookexternalhit|facebot|whatsapp|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|skypeuripreview|pinterestbot)
		not path /api/* /assets/* /media/* /images/* /fonts/* /healthz
		not path_regexp \.[a-z0-9]+$
	}
	handle @linkpreview {
		rewrite * /api/content/share-html?path={http.request.uri.path}
		reverse_proxy {$API_UPSTREAM:attentive-api:3000}
	}

	# sitemap.xml is built by the API from portal data; the static file is the fallback.
	handle /sitemap.xml {
		rewrite * /api/content/sitemap.xml
		reverse_proxy {$API_UPSTREAM:attentive-api:3000} {
			@down status 5xx
			handle_response @down {
				rewrite * /sitemap.xml
				file_server
			}
		}
	}

	# API unreachable: serve the static sitemap instead of an error.
	handle_errors {
		@sitemap expression {http.request.orig_uri.path} == '/sitemap.xml'
		handle @sitemap {
			root * /srv
			rewrite * /sitemap.xml
			header Content-Type application/xml
			file_server
		}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@media path /media/*
	header @media Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	@html path / /index.html
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	# The assessment forms are standalone pages (they are not part of the single-page app): /assessments/mhcu serves the form file.
	@mhcu path /assessments/mhcu /assessments/mhcu/
	handle @mhcu {
		rewrite * /assessments-static/mhcu.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	@gsc path /assessments/goal-compass /assessments/goal-compass/
	handle @gsc {
		rewrite * /assessments-static/gsc.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
	# The counselor console holds no data of its own: staff open it from the portal with the session in the #d= part of the address.
	@gscconsole path /assessments/goal-compass/konselor /assessments/goal-compass/konselor/
	handle @gscconsole {
		rewrite * /assessments-static/gsc-konselor.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}

	# PDF files (the sample reports linked from the result e-mail) open inline in the browser's own viewer. The site-wide policy
	# above has object-src 'none', which stops Chrome's PDF viewer from showing a PDF opened in its own tab, so a PDF gets a
	# policy without it (it can still load nothing from other sites).
	@pdf path *.pdf
	header @pdf {
		>Content-Security-Policy "default-src 'self'; frame-ancestors 'none'"
		Content-Disposition inline
		Cache-Control "public, max-age=3600"
	}

	# try_files must sit inside a handle: as a top-level directive it runs before every handle block
	# and would rewrite the path to /index.html before the matchers above can see the real one.
	handle {
		try_files {path} /index.html
		file_server
	}
}
