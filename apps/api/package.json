{
    "name": "@attentiveid/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "build": "bun build src/index.ts --outfile=dist/index.js --target=bun",
        "start": "bun run dist/index.js",
        "db:generate": "drizzle-kit generate --name=shared_content_foundation",
        "db:migrate": "bun src/db/migrate.ts",
        "db:seed:landing": "bun src/db/seed-landing.ts",
        "db:seed:psychologists": "bun src/db/seed-psychologists.ts",
        "db:seed:users": "bun src/db/seed-users.ts"
    },
    "dependencies": {
        "@attentiveid/shared": "workspace:*",
        "@elysiajs/cors": "^1.2.0",
        "@elysiajs/swagger": "^1.2.0",
        "@sinclair/typebox": "^0.34.49",
        "drizzle-orm": "^0.45.2",
        "elysia": "^1.2.0",
        "postgres": "^3.4.4"
    },
    "devDependencies": {
        "@types/bun": "1.4.0",
        "drizzle-kit": "^0.31.10"
    }
}
