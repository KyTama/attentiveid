{
    "name": "attentiveid",
    "version": "0.1.0",
    "private": true,
    "packageManager": "bun@1.4.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --watch apps/api/src/index.ts",
        "dev:api": "bun --watch run apps/api/src/index.ts",
        "dev:web": "cd apps/web && bun run dev",
        "lint": "cd apps/web && bun run lint",
        "test": "bun run test:web && ./scripts/ci/verify-workflow-contracts.sh --fixtures-only && ./scripts/ci/verify-environment-readiness.sh --fixtures-only && ./scripts/ci/verify-migration-evidence.sh tests/fixtures/deploy/migration.valid.json",
        "test:web": "cd apps/web && bun run test",
        "verify": "./scripts/ci/verify.sh",
        "build": "bun run build:api && bun run build:web",
        "build:api": "cd apps/api && bun build src/index.ts --outfile=dist/index.js --target=bun",
        "build:web": "cd apps/web && bun run build",
        "start": "bun run apps/api/src/index.ts",
        "db:generate": "cd apps/api && bunx drizzle-kit generate",
        "db:migrate": "cd apps/api && bunx drizzle-kit migrate"
    },
    "devDependencies": {
        "@types/bun": "1.4.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "js-yaml": "^5.2.0"
    }
}
