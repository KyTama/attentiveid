# GitHub Environment variable
COMPOSE_PROJECT_NAME=attentive-staging
# Trusted build manifest value
WEB_IMAGE=ghcr.io/kytama/attentiveid-web@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Trusted build manifest value
API_IMAGE=ghcr.io/kytama/attentiveid-api@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# GitHub Environment variable
DOMAIN=staging.attentive.example
# Host inventory variable
INGRESS_NETWORK=shared-ingress
# Host inventory variable
POSTGRES_NETWORK=shared-postgres
# Host-local API secret path; file contains DATABASE_URL and PREVIEW_HMAC_SECRET
HOST_SECRET_FILE=/etc/attentive/staging.secret.env
# GitHub Environment variable
FRONTEND_URL=https://staging.attentive.example
# Dedicated host-local PostgreSQL identity
DATABASE_NAME=attentive_staging
# Dedicated host-local PostgreSQL identity
DATABASE_ROLE=attentive_staging
