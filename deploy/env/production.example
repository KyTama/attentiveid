# GitHub Environment variable
COMPOSE_PROJECT_NAME=attentive-production
# Trusted staged manifest value
WEB_IMAGE=ghcr.io/kytama/attentiveid-web@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
# Trusted staged manifest value
API_IMAGE=ghcr.io/kytama/attentiveid-api@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
# GitHub Environment variable
DOMAIN=attentive.example
# Host inventory variable
INGRESS_NETWORK=shared-ingress
# Host inventory variable
POSTGRES_NETWORK=shared-postgres
# Host-local API secret path; file contains DATABASE_URL and PREVIEW_HMAC_SECRET
HOST_SECRET_FILE=/etc/attentive/production.secret.env
# GitHub Environment variable
FRONTEND_URL=https://attentive.example
# Dedicated host-local PostgreSQL identity
DATABASE_NAME=attentive_production
# Dedicated host-local PostgreSQL identity
DATABASE_ROLE=attentive_production
