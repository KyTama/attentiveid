# PostgreSQL Connection to shared instance
DATABASE_URL=postgresql://user:password@postgres-shared:5432/attentiveid

# PostgreSQL admin connection used only by disposable local verification
DATABASE_ADMIN_URL=postgresql://postgres:password@127.0.0.1:5432/postgres

# Unique 32+ byte secret for signed, expiring landing preview capabilities
PREVIEW_HMAC_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes

# API Port
PORT=3000

# Frontend Proxy URL
FRONTEND_URL=http://localhost:5173
